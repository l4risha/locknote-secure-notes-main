# ---------------------------------------------------------------------------
# Secrets / environment files  (never commit real credentials)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
secrets/
secrets.json

# ---------------------------------------------------------------------------
# Dart / Flutter
# ---------------------------------------------------------------------------
.dart_tool/
.packages
build/
frontend/build/
backend/build/
.flutter-plugins
.flutter-plugins-dependencies
migration_rules

# Flutter web caches / generated bootstrap (regenerated by `flutter build`)
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/web/flutter_service_worker.js
frontend/web/icons/Icon-*

# Coverage & test artifacts
coverage/
*.lcov
test/.test_coverage.dart

# ---------------------------------------------------------------------------
# IDE / OS
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Logs & local runtime data
# ---------------------------------------------------------------------------
*.log
logs/
pgdata/
!.env.example
