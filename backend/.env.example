# LockNote backend configuration
#
# Copy this file to `.env` (which is git-ignored) and fill in real values:
#     cp .env.example .env
#
# Real environment variables always override values from the `.env` file.
# NEVER commit a real `.env` file to GitHub.

# --- PostgreSQL (required) -------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=locknote
DB_USER=locknote
DB_PASSWORD=change-me-strong-password

# --- HTTP server -----------------------------------------------------------
# Interface and port the Shelf server listens on.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Comma-separated list of browser origins allowed to call the API during
# development (leave empty to allow any origin — only acceptable because the
# API uses Bearer tokens, never cookies).
ALLOWED_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# Directory with a built Flutter web app (e.g. ../frontend/build/web).
# When set, the server also serves the UI from the same origin.
# Leave empty to serve the API only.
STATIC_DIR=

# --- Security --------------------------------------------------------------
# Lifetime of a login session token.
SESSION_TTL_HOURS=720

# PBKDF2-HMAC-SHA256 work factor used for password hashing.
# Raising it makes stolen hashes slower to crack, but logins slower too.
# Leave empty to use the built-in default.
PBKDF2_ITERATIONS=

# --- Database migrations ---------------------------------------------------
# Apply pending migrations automatically when the server starts.
AUTO_MIGRATE=true
